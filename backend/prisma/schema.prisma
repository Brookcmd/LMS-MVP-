generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AttendanceStatus {
  present
  absent
  late
}

enum NotificationType {
  absence
}

enum AssessmentType {
  assignment
  exam
  quiz
  project
}

enum DayOfWeek {
  monday
  tuesday
  wednesday
  thursday
  friday
}

model School {
  id        Int       @id @default(autoincrement())
  name      String
  createdAt DateTime  @default(now()) @map("created_at")

  users    User[]
  students Student[]
  classes  Class[]
  subjects Subject[]

  @@map("schools")
}

model User {
  id           Int       @id @default(autoincrement())
  schoolId     Int       @map("school_id")
  role         String    // 'admin' | 'teacher' | 'parent' | 'student'
  name         String
  email        String
  phone        String?
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at")

  school           School           @relation(fields: [schoolId], references: [id])
  parentChildren   ParentStudent[]  @relation("parent")
  classesTeaching  ClassTeacher[]
  homeroomClasses  Class[]           @relation("homeroom_teacher")
  teachingAssignments TeachingAssignment[]
  attendanceMarked Attendance[]     @relation("marked_by")
  notifications    Notification[]   @relation("notification_parent")
  createdAssessments Assessment[]   @relation("assessment_teacher")
  scheduleSlots  ScheduleSlot[]   @relation("schedule_teacher")

  @@unique([email, schoolId])
  @@map("users")
}

model Student {
  id        Int       @id @default(autoincrement())
  schoolId  Int       @map("school_id")
  classId   Int       @map("class_id")
  name      String
  dob       DateTime?
  createdAt DateTime  @default(now()) @map("created_at")

  school       School          @relation(fields: [schoolId], references: [id])
  class        Class           @relation(fields: [classId], references: [id], onDelete: Restrict)
  parents      ParentStudent[] @relation("student")
  attendances  Attendance[]
  notifications Notification[]
  grades        Grade[]

  @@map("students")
}

model ParentStudent {
  parentUserId Int
  studentId    Int
  relationship String?
  isPrimary    Boolean @default(false) @map("is_primary")

  parent  User    @relation("parent", fields: [parentUserId], references: [id])
  student Student @relation("student", fields: [studentId], references: [id])

  @@id([parentUserId, studentId])
  @@map("parent_students")
}

model Class {
  id        Int       @id @default(autoincrement())
  schoolId  Int       @map("school_id")
  name      String
  homeroomTeacherId Int? @map("homeroom_teacher_id")
  createdAt DateTime  @default(now()) @map("created_at")

  school      School       @relation(fields: [schoolId], references: [id])
  homeroomTeacher User?    @relation("homeroom_teacher", fields: [homeroomTeacherId], references: [id], onDelete: SetNull)
  students    Student[]
  teachers    ClassTeacher[]
  teachingAssignments TeachingAssignment[]
  attendances Attendance[]
  assessments Assessment[]
  scheduleSlots ScheduleSlot[]

  @@map("classes")
}

model ClassTeacher {
  classId  Int @map("class_id")
  teacherId Int @map("teacher_id")

  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher User  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([classId, teacherId])
  @@map("class_teachers")
}

model Subject {
  id        Int      @id @default(autoincrement())
  schoolId  Int      @map("school_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  school              School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teachingAssignments TeachingAssignment[]
  assessments         Assessment[]
  scheduleSlots       ScheduleSlot[]

  @@unique([schoolId, name])
  @@map("subjects")
}

model TeachingAssignment {
  id        Int      @id @default(autoincrement())
  classId   Int      @map("class_id")
  teacherId Int      @map("teacher_id")
  subjectId Int      @map("subject_id")
  createdAt DateTime @default(now()) @map("created_at")

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher User    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  grades  Grade[]

  @@unique([classId, teacherId, subjectId])
  @@index([teacherId, classId])
  @@map("teaching_assignments")
}

model Grade {
  id                   Int      @id @default(autoincrement())
  studentId            Int      @map("student_id")
  teachingAssignmentId Int      @map("teaching_assignment_id")
  academicYear         String   @map("academic_year")
  quarter              Int
  score                Int
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  student            Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teachingAssignment TeachingAssignment @relation(fields: [teachingAssignmentId], references: [id], onDelete: Cascade)

  @@unique([studentId, teachingAssignmentId, academicYear, quarter])
  @@index([teachingAssignmentId, academicYear, quarter])
  @@map("grades")
}

model Attendance {
  id        Int       @id @default(autoincrement())
  studentId Int       @map("student_id")
  classId   Int       @map("class_id")
  date      DateTime
  status    AttendanceStatus
  markedBy  Int       @map("marked_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])
  marked  User    @relation("marked_by", fields: [markedBy], references: [id])
  notifications Notification[]

  @@unique([studentId, classId, date])
  @@map("attendances")
}

model Notification {
  id           Int              @id @default(autoincrement())
  parentUserId Int              @map("parent_user_id")
  studentId    Int              @map("student_id")
  attendanceId Int              @map("attendance_id")
  type         NotificationType @default(absence)
  readAt       DateTime?        @map("read_at")
  createdAt    DateTime         @default(now()) @map("created_at")

  parent     User       @relation("notification_parent", fields: [parentUserId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@unique([parentUserId, attendanceId])
  @@index([parentUserId, readAt, createdAt])
  @@map("notifications")
}

model Assessment {
  id          Int            @id @default(autoincrement())
  title       String
  description String?
  type        AssessmentType @default(assignment)
  dueDate     DateTime       @map("due_date")
  classId     Int            @map("class_id")
  subjectId   Int            @map("subject_id")
  teacherId   Int            @map("teacher_id")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher User    @relation("assessment_teacher", fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([classId, dueDate])
  @@index([teacherId])
  @@map("assessments")
}

model ScheduleSlot {
  id        Int       @id @default(autoincrement())
  classId   Int       @map("class_id")
  subjectId Int       @map("subject_id")
  teacherId Int       @map("teacher_id")
  dayOfWeek DayOfWeek @map("day_of_week")
  startTime String    @map("start_time")  // "HH:MM" 24-hour
  endTime   String    @map("end_time")    // "HH:MM" 24-hour
  room      String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher User    @relation("schedule_teacher", fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([classId, dayOfWeek, startTime])
  @@index([classId, dayOfWeek])
  @@index([teacherId])
  @@map("schedule_slots")
}
